# Anthropic API key
ANTHROPIC_API_KEY=

# Course hub API key (provided during the course)
HUB_API_KEY=

# Course hub base URL (provided during the course)
HUB_BASE_URL=

# OpenRouter API key (optional — for using non-Anthropic models)
OPENROUTER_API_KEY=
