# Anthropic API key
ANTHROPIC_API_KEY=

# Course hub API key (provided during the course)
HUB_API_KEY=

# Course hub base URL (provided during the course)
HUB_BASE_URL=

# Task-specific identifiers (provided during the course)
HUB_TARGET_ID=
HUB_PLANT_ID=

# OpenRouter API key (optional — for using non-Anthropic models)
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Your repo or site — used only for OpenRouter attribution / rankings (API works without it)
# OPENROUTER_HTTP_REFERER=https://github.com/YOUR_USER/YOUR_REPO
# OPENROUTER_X_TITLE=my-aiDevs-scripts
# OPENROUTER_MODEL=
# OPENROUTER_DEFAULT_MODEL=
# STEP_ANALYZE_MODEL=

# S03E15 SaveThem — no extra vars needed (uses HUB_API_KEY + HUB_BASE_URL)

# S03E16 OKO Editor — record IDs for the OKO panel (find via web panel HTML source)
# 32-char hex ID shared by the Skolwin incydent, notatka, and zadanie
OKO_SKOLWIN_ID=
# 32-char hex ID of an existing incydenty entry to repurpose as the Komarowo incident
OKO_KOMAROWO_ID=

# AI-first analysis step model (used by tasks that call chat() for data interpretation)
# Leave empty to use MODEL_OVERRIDE or the default model
# Example: claude-sonnet-4-6 (direct) or openai/gpt-4o (via OpenRouter)
STEP_ANALYZE_MODEL=

# S04E18 Filesystem — no extra vars needed (uses HUB_API_KEY + HUB_BASE_URL + STEP_ANALYZE_MODEL)

# S04E20 Food Warehouse — no extra vars needed (uses HUB_API_KEY + HUB_BASE_URL)

# S04E21 Radiomonitoring — no extra vars needed (uses HUB_API_KEY + HUB_BASE_URL + STEP_ANALYZE_MODEL)
# STEP_ANALYZE_MODEL also drives vision calls during the listen loop (image attachments)
# Creator ID and city destination codes are discovered at runtime from the SQLite database

# S03E04 Negotiations — public HTTP tool server
# Port the search server listens on (default: 3002)
NEGOTIATIONS_PORT=3002
# Publicly reachable URL of the server (required before registering tools with the hub)
# Use ngrok: ngrok http 3002 — then set this to the https://xxxxx.ngrok-free.app URL
NEGOTIATIONS_PUBLIC_URL=
