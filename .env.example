# OPENROUTER_HTTP_REFERER=https://github.com/YOUR_USER/YOUR_REPO
# OPENROUTER_X_TITLE=my-aiDevs-scripts
# OPENROUTER_MODEL=
# OPENROUTER_DEFAULT_MODEL=
# STEP_ANALYZE_MODEL=
